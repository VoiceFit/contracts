{
  "name": "@voicefit/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "보이스핏 스키마 계약 — web·api·agent가 같은 원본을 쓴다",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "json-schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:json-schema": "pnpm build && node scripts/export-json-schema.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
