# @voicefit 비공개 패키지는 GitHub Packages에서 받는다.
# 토큰은 이 파일에 적지 않는다 — pnpm 12는 .npmrc의 ${환경변수}를 풀어 주지 않으므로 사용자 설정에 넣는다.
#   로컬: pnpm config set -g "//npm.pkg.github.com/:_authToken" "$(gh auth token)"
#   CI:   echo "//npm.pkg.github.com/:_authToken=$TOKEN" >> ~/.npmrc
@voicefit:registry=https://npm.pkg.github.com
